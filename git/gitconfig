# ~/.gitconfig — symlinked from the dotfiles repo, which is PUBLIC.
[user]
	name = Vasco Santos
	email = santos.vasco10@gmail.com

[core]
	excludesfile = ~/.config/git/ignore

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

# Work identity, without committing an employer's address to a public repo.
# Anything in ~/work/ uses ~/.gitconfig-work; both files are untracked and
# a missing include is silently ignored by git.
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work

[include]
	path = ~/.gitconfig.local
